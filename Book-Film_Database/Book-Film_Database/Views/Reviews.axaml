<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Book_Film_Database.Models"
             x:Class="Book_Film_Database.ReviewsList"
             Background="#040012">
    
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" Margin="20" HorizontalAlignment="Stretch">
            <TextBlock Text="User review" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Button Content="Add review" Click="AddReviewButton_OnClick" Background="#0e0433" Foreground="White" Padding="15,10" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, 400" Margin="20,0,20,20">
            
            <ListBox Grid.Column="0" x:Name="ReviewsListBox" Background="#040012" Margin="0,0,20,0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Review">
                        <Border Background="#0e0433" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel Spacing="5">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding Genre, StringFormat='({0})'}" FontSize="14" Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Rating, StringFormat='{}{0}/10 ⭐'}" FontSize="16" FontWeight="Bold" Foreground="Gold" VerticalAlignment="Center"/>
                                        
                                        <Button Content="❌" 
                                                Click="DeleteReviewButton_OnClick" 
                                                Background="Transparent" 
                                                Padding="5" 
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Text}" FontSize="14" Foreground="LightGray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" x:Name="AddReviewPanel" IsVisible="False" Background="#0e0433" CornerRadius="8" Padding="20" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock Text="New Review" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                    
                    <TextBlock Text="Name:" Foreground="Gray"/>
                    <TextBox x:Name="TitleInput" PlaceholderText="Name anime/manga..."/>
                    
                    <TextBlock Text="Genre:" Foreground="Gray"/>
                    <TextBox x:Name="GenreInput" PlaceholderText="Drama, Fantasy..."/>
                    
                    <TextBlock Text="Rating (1-10):" Foreground="Gray"/>
                    <TextBox x:Name="RatingInput" PlaceholderText="10"/>
                    
                    <TextBlock Text="Review:" Foreground="Gray"/>
                    <TextBox x:Name="ReviewContentInput" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                    
                    <Grid ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Content="Save" Click="SaveButton_OnClick" Background="#31108f" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,5,0"/>
                        <Button Grid.Column="1" Content="Cancel" Click="CancelButton_OnClick" Background="Transparent" Foreground="Gray" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,10,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>