<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="Book_Film_Database.MainWindow"
        Title="Book_Film_Database"
        Background="#040012"
        RequestedThemeVariant="Dark">
        
        <StackPanel>
                <UniformGrid  Rows="1" Columns="5" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="50" Background="#0a0026">        
                        <Button Content="Overview" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#0a0026"></Button> 
                        <Button Content="Anime List" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#0a0026" Click="AnimeListButton"></Button>
                        <Button Content="Manga List" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#0a0026" Click="MangaListButton"></Button>
                        <Button Content="Favorites" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#0a0026" Click="FavoritesListButton"></Button>
                        <Button Content="Reviews" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#0a0026" Click="ReviewsListButton"></Button>
                </UniformGrid>
                <StackPanel Orientation="Vertical" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="MidnightBlue">
                </StackPanel>
                <ContentControl Name="MainContent"/>
        </StackPanel>        
        
        <!-- 
        <Grid>
                <Grid RowDefinitions="*" ColumnDefinitions="*, *, *, *" VerticalAlignment="Top" HorizontalAlignment="Center" ShowGridLines="False" Height="50" Width="1920" Background="#0a0026"> 
                        <Button Content="Overview" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Background="#0a0026"></Button> 
                        <Button Content="Anime List" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Background="#0a0026"></Button>
                        <Button Content="Manga List" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Background="#0a0026"></Button>
                        <Button Content="Favorites" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" Background="#0a0026"></Button>
                        <Button Content="Reviews" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" Background="#0a0026"></Button>
                </Grid>
                <StackPanel Orientation="Vertical" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="MidnightBlue">
                </StackPanel>
        </Grid> 
        -->
        
</Window>
